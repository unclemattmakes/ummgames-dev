{
  "name": "@ummgames/dev",
  "version": "0.6.0",
  "description": "Shared dev tools for Uncle Matt Makes Games: capture, trailer and store art, site build plugins, agent tooling and configs.",
  "license": "MIT",
  "author": "Uncle Matt Makes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unclemattmakes/ummgames-dev.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "umm-dev": "./bin/umm-dev.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./vite": {
      "types": "./src/vite/index.d.ts",
      "default": "./src/vite/index.mjs"
    },
    "./testing": {
      "types": "./src/testing/index.d.ts",
      "default": "./src/testing/index.mjs"
    },
    "./media": {
      "types": "./src/media/index.d.ts",
      "default": "./src/media/index.mjs"
    },
    "./audio": {
      "types": "./src/audio/index.d.ts",
      "default": "./src/audio/index.mjs"
    },
    "./gltf": {
      "types": "./src/gltf/index.d.ts",
      "default": "./src/gltf/index.mjs"
    },
    "./biome": "./config/biome.preset.json",
    "./tsconfig": "./config/tsconfig.json",
    "./vitest": {
      "types": "./config/vitest.d.ts",
      "default": "./config/vitest.mjs"
    },
    "./playwright": {
      "types": "./config/playwright.d.ts",
      "default": "./config/playwright.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "config",
    "runtime",
    "presets",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "tsc -p tsconfig.json && tsc -p runtime/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:slow": "vitest run --project slow"
  },
  "peerDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "playwright": ">=1.50",
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "@gltf-transform/core": {
      "optional": true
    },
    "@gltf-transform/extensions": {
      "optional": true
    },
    "@gltf-transform/functions": {
      "optional": true
    },
    "meshoptimizer": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "22.19.1",
    "meshoptimizer": "1.3.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
